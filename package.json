{
  "name": "@sudobility/entity_service",
  "version": "1.0.48",
  "description": "Shared entity/organization management library for multi-tenant workspaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware/hono": {
      "import": "./dist/middleware/hono.js",
      "types": "./dist/middleware/hono.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/entities.js",
      "types": "./dist/schema/entities.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify": "bun run typecheck && bun run lint && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "entity",
    "organization",
    "workspace",
    "multi-tenant",
    "hono",
    "drizzle"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.75",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "vitest": "~4.1.12",
    "@sudobility/types": "^1.9.75",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-orm": "~0.45.4",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "hono": "~4.13.13",
    "postgres": "~3.4.9",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/entity_service.git"
  }
}
